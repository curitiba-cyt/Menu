    <script src="https://unpkg.com/@ffmpeg/ffmpeg@0.11.6/dist/ffmpeg.min.js"></script>
    <script>
        const { createFFmpeg, fetchFile } = FFmpeg;
        const ffmpeg = createFFmpeg({ log: true });
        const fileInput = document.getElementById('fileInput');
        const convertBtn = document.getElementById('convertBtn');
        const status = document.getElementById('status');
        const progressBar = document.getElementById('progressBar');
        const progressFill = document.getElementById('progressFill');
        const downloadLink = document.getElementById('downloadLink');

        fileInput.addEventListener('change', () => {
            if (fileInput.files.length > 0) {
                convertBtn.disabled = false;
                status.innerText = "Arquivo selecionado: " + fileInput.files[0].name;
            }
        });

        async function convertVideo() {
            if (!fileInput.files.length) return;

            convertBtn.disabled = true;
            status.innerText = "Carregando motor de conversão...";
            progressBar.style.display = "block";

            try {
                if (!ffmpeg.isLoaded()) {
                    await ffmpeg.load();
                }

                status.innerText = "Processando arquivo no seu dispositivo...";
                const file = fileInput.files[0];
                ffmpeg.FS('writeFile', 'input.mp4', await fetchFile(file));

                ffmpeg.setProgress(({ ratio }) => {
                    progressFill.style.width = `${Math.round(ratio * 100)}%`;
                });

                await ffmpeg.run('-i', 'input.mp4', '-q:a', '0', '-map', 'a', 'output.mp3');

                const data = ffmpeg.FS('readFile', 'output.mp3');
                const audioBlob = new Blob([data.buffer], { type: 'audio/mp3' });
                const url = URL.createObjectURL(audioBlob);

                downloadLink.href = url;
                downloadLink.download = file.name.replace('.mp4', '') + '.mp3';
                downloadLink.style.display = "inline-block";
                
                status.innerText = "Conversão concluída com sucesso!";
            } catch (error) {
                console.error(error);
                status.innerText = "Ocorreu um erro ao processar o arquivo.";
                convertBtn.disabled = false;
            }
        }
    </script>

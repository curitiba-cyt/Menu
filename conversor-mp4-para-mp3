<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Conversor de MP4 para MP3 - Grátis e Rápido</title>
    <meta name="description" content="Converta seus vídeos MP4 para áudio MP3 diretamente no seu navegador, sem limites e com total privacidade.">

    <!-- Open Graph Tags -->
    <meta property="og:title" content="Conversor de MP4 para MP3 - Grátis e Ilimitado">
    <meta property="og:description" content="Extraia o áudio dos seus vídeos MP4 diretamente pelo navegador com alta velocidade e total segurança.">
    <meta property="og:url" content="https://conversor-mp4-para-mp3.vercel.app/">
    <meta property="og:type" content="website">
    <meta property="og:image" content="https://conversor-mp4-para-mp3.vercel.app/banner.png">

    <!-- Script Popunder AdSterra -->
    <script src="https://pl30577899.effectivecpmnetwork.com/b6/f9/de/b6f9de0eb9d4fb94e409fcc1474f7f93.js"></script>

    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: system-ui, -apple-system, sans-serif; }
        body { background-color: #f4f6f9; color: #333; display: flex; flex-direction: column; align-items: center; min-height: 100vh; padding: 20px; }
        header { text-align: center; margin-bottom: 20px; }
        h1 { font-size: 1.8rem; color: #1a1a1a; margin-bottom: 8px; }
        p { color: #666; font-size: 0.95rem; }
        .container { background: #fff; padding: 25px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); width: 100%; max-width: 600px; text-align: center; }
        .ad-space { background: #f0f0f0; border: 1px dashed #ccc; min-height: 90px; margin: 15px 0; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; color: #888; }
        .upload-area { border: 2px dashed #0070f3; padding: 30px; border-radius: 8px; background: #f8fafc; cursor: pointer; margin-bottom: 20px; }
        .upload-area input { display: none; }
        button { background: #0070f3; color: #fff; border: none; padding: 12px 24px; font-size: 1rem; border-radius: 6px; cursor: pointer; font-weight: 600; width: 100%; }
        button:disabled { background: #ccc; cursor: not-allowed; }
        #status { margin-top: 15px; font-size: 0.9rem; font-weight: 500; }
        .progress-bar { width: 100%; background: #eee; height: 10px; border-radius: 5px; margin-top: 10px; overflow: hidden; display: none; }
        .progress-fill { background: #0070f3; height: 100%; width: 0%; transition: width 0.2s; }
    </style>
</head>
<body>

    <header>
        <h1>Conversor de MP4 para MP3</h1>
        <p>Extraia o áudio dos seus vídeos com velocidade e total segurança</p>
    </header>

    <div class="ad-space" id="ad-top">
        <span>Espaço Reservado para Anúncio (Topo)</span>
    </div>

    <div class="container">
        <div class="upload-area" onclick="document.getElementById('fileInput').click()">
            <p>Clique aqui para selecionar seu vídeo MP4</p>
            <input type="file" id="fileInput" accept="video/mp4">
        </div>

        <button id="convertBtn" onclick="convertVideo()" disabled>Converter para MP3</button>

        <div class="progress-bar" id="progressBar">
            <div class="progress-fill" id="progressFill"></div>
        </div>

        <p id="status"></p>

        <a id="downloadLink" style="display:none; margin-top: 15px; text-decoration: none;">
            <button style="background: #10b981;">Baixar Arquivo MP3</button>
        </a>
    </div>

    <div class="ad-space" id="ad-bottom">
        <span>Espaço Reservado para Anúncio (Rodapé)</span>
    </div>

    <script src="https://unpkg.com/@ffmpeg/ffmpeg@0.11.6/dist/ffmpeg.min.js"></script>
    <script>
        const { createFFmpeg, fetchFile } = FFmpeg;
        const ffmpeg = createFFmpeg({ log: true });
        const fileInput = document.getElementById('fileInput');
        const convertBtn = document.getElementById('convertBtn');
        const status = document.getElementById('status');
        const progressBar = document.getElementById('progressBar');
        const progressFill = document.getElementById('progressFill');
        const downloadLink = document.getElementById('downloadLink');

        fileInput.addEventListener('change', () => {
            if (fileInput.files.length > 0) {
                convertBtn.disabled = false;
                status.innerText = "Arquivo selecionado: " + fileInput.files[0].name;
            }
        });

        async function convertVideo() {
            if (!fileInput.files.length) return;

            convertBtn.disabled = true;
            status.innerText = "Carregando motor de conversão...";
            progressBar.style.display = "block";

            try {
                if (!ffmpeg.isLoaded()) {
                    await ffmpeg.load();
                }

                status.innerText = "Processando arquivo no seu dispositivo...";
                const file = fileInput.files[0];
                ffmpeg.FS('writeFile', 'input.mp4', await fetchFile(file));

                ffmpeg.setProgress(({ ratio }) => {
                    progressFill.style.width = `${Math.round(ratio * 100)}%`;
                });

                await ffmpeg.run('-i', 'input.mp4', '-q:a', '0', '-map', 'a', 'output.mp3');

                const data = ffmpeg.FS('readFile', 'output.mp3');
                const audioBlob = new Blob([data.buffer], { type: 'audio/mp3' });
                const url = URL.createObjectURL(audioBlob);

                downloadLink.href = url;
                downloadLink.download = file.name.replace('.mp4', '') + '.mp3';
                downloadLink.style.display = "inline-block";
                
                status.innerText = "Conversão concluída com sucesso!";
            } catch (error) {
                console.error(error);
                status.innerText = "Ocorreu um erro ao processar o arquivo.";
                convertBtn.disabled = false;
            }
        }
    </script>
</body>
</html>

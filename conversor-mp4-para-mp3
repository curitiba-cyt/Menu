<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Conversor de MP4 para MP3 - Grátis e Rápido</title>
  <meta name="description" content="Converta seus vídeos MP4 em áudio MP3 diretamente no navegador com segurança e velocidade.">
  <meta property="og:title" content="Conversor de MP4 para MP3">
  <meta property="og:description" content="Extraia áudio de vídeos MP4 instantaneamente.">
  <style>
    body { font-family: Arial, sans-serif; background: #f4f6f9; margin: 0; padding: 20px; text-align: center; color: #333; }
    .container { max-width: 600px; margin: 0 auto; background: #fff; padding: 25px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
    h1 { font-size: 24px; margin-bottom: 8px; }
    p { font-size: 14px; color: #666; margin-bottom: 20px; }
    .file-input-container { border: 2px dashed #0070f3; padding: 20px; border-radius: 8px; background: #f0f7ff; cursor: pointer; margin-bottom: 15px; }
    input[type="file"] { display: none; }
    .btn { background: #0070f3; color: white; border: none; padding: 12px 24px; border-radius: 6px; font-weight: bold; cursor: pointer; width: 100%; font-size: 16px; }
    .btn:disabled { background: #ccc; cursor: not-allowed; }
    .ad-container { margin: 20px 0; text-align: center; }
    footer { margin-top: 30px; font-size: 13px; color: #777; }
    footer a { color: #0070f3; text-decoration: none; font-weight: bold; }
  </style>
</head>
<body>

  <div class="ad-container">
    <!-- Adsterra 728x90 Banner -->
    <script type="text/javascript">
      atOptions = {
        'key' : 'SEU_KEY_728X90_AQUI',
        'format' : 'iframe',
        'height' : 90,
        'width' : 728,
        'params' : {}
      };
    </script>
    <script type="text/javascript" src="//www.highperformanceformat.com/SEU_KEY_728X90_AQUI/invoke.js"></script>
  </div>

  <div class="container">
    <h1>Conversor de MP4 para MP3</h1>
    <p>Extraia o áudio dos seus vídeos com velocidade e total segurança</p>

    <div class="file-input-container" onclick="document.getElementById('fileInput').click()">
      <span id="fileName">Clique aqui para selecionar seu vídeo MP4</span>
      <input type="file" id="fileInput" accept="video/mp4" onchange="updateFileName()">
    </div>

    <button id="convertBtn" class="btn" onclick="convertVideo()" disabled>Converter para MP3</button>
  </div>

  <div class="ad-container">
    <!-- Adsterra Native Banner -->
    <script async="async" data-cfasync="false" src="//www.highperformanceformat.com/SEU_KEY_NATIVE/invoke.js"></script>
    <div id="container-SEU_KEY_NATIVE"></div>
  </div>

  <footer>
    Desenvolvido por <a href="https://alemtech.com.br" target="_blank" rel="noopener">alemtech.com.br</a>
  </footer>

  <!-- Adsterra Popunder e Social Bar -->
  <script type='text/javascript' src='//www.highperformanceformat.com/SEU_KEY_POPUNDER/invoke.js'></script>
  <script type='text/javascript' src='//www.highperformanceformat.com/SEU_KEY_SOCIALBAR/invoke.js'></script>

  <script>
    function updateFileName() {
      const input = document.getElementById('fileInput');
      const label = document.getElementById('fileName');
      const btn = document.getElementById('convertBtn');
      if (input.files.length > 0) {
        label.innerText = input.files[0].name;
        btn.disabled = false;
      }
    }

    function convertVideo() {
      alert("Selecione os IDs válidos da AdSterra para ativá-lo totalmente.");
    }
  </script>
</body>
</html>
